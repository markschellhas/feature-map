{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature Map",
  "type": "object",
  "required": ["feature_name", "purpose", "entry_points"],
  "properties": {
    "feature_name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "apps": {
      "type": ["array", "object"]
    },
    "user_flow": {
      "type": "object"
    },
    "related_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}